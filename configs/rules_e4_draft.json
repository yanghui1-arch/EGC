{
  "schema_version": 1,
  "version": "e4-source-grounded-mechanism-draft-v1",
  "status": "exploratory_partial_rules_not_training_release",
  "scope": "仅用于两罪名的规则组合机制设计；不是完整定罪量刑系统，不生成或裁剪法定刑期。所有适用性门控需案时/地域与法律版本核验，不能由标签倒推。",
  "conditions": [
    {"id": "scope_surrender", "text": "经独立核验，1998年自首解释及2010年意见的本草案相关条款适用于目标人物、目标罪行和本案法律适用时期；没有核验为unknown。"},
    {"id": "legal_voluntary_surrender", "text": "目标人物到案经过符合适用法律版本的自动投案定义，包括经核验的视为投案情形；不直接复制E3主动到案状态。"},
    {"id": "main_facts_disclosed", "text": "按目标罪行及同种多次行为的范围核验，目标人物如实交代主要犯罪事实；部分供述、目录或无异议不能自动替代。"},
    {"id": "joint_disclosure_satisfied", "text": "若为共同犯罪，已核实满足同案犯及主要事实的供述要求；有明确非共同犯罪证据时亦满足。范围不明为unknown。"},
    {"id": "identity_disclosure_satisfied", "text": "身份等供述真实，或差异经核验不影响定罪量刑；不能仅凭主要行为供述默认满足。"},
    {"id": "escaped_after_surrender", "text": "目标人物自动投案后又逃跑；未提及后续经过为unknown，不能默认为refuted。"},
    {"id": "retracted_after_disclosure", "text": "目标人物在自动投案并如实供述后又翻供；只争议法律定性不自动算翻供，未记载为unknown。"},
    {"id": "truth_restored_before_judgment", "text": "发生翻供后，一审判决前又恢复如实供述；需要恢复内容与时间证据，未记载为unknown。"},
    {"id": "crime_minor_verified", "text": "经适用规则及源事实核验目标犯罪属于较轻情形；不是从参考刑期短或教师判断倒推。"},
    {"id": "scope_fraud_article3", "text": "经核验法释2011年7号第三条适用于本案；包含地方数额标准、法律适用时点及该条适用范围，不能仅凭给定诈骗罪或一个金额默认满足。"},
    {"id": "admitted_guilt", "text": "目标人物对目标犯罪认罪；需要源事实，不能从未提出异议机械推断。"},
    {"id": "repented", "text": "源材料能支持目标人物悔罪；认罪、赔偿或给定罪名本身不自动证明悔罪。"},
    {"id": "full_restitution_before_judgment", "text": "目标案财物在一审宣判前已全部退赃退赔，需全额范围与时点证据；部分、承诺及单纯追缴不够，未记载为unknown。"},
    {"id": "target_victim_forgiveness", "text": "与目标人物和目标罪行对应的被害人明确谅解；多人、多案范围不明为unknown，不能直接迁移旧状态。"},
    {"id": "scope_robbery_2016", "text": "经核验法发2016年2号第二部分的相应认定规则适用于本案；2016年1月6日是印发日期，不用网页发布时间或犯罪年份直接决定个案适用。"},
    {"id": "home_premises_verified", "text": "目标地点符合适用法下户的定义；混合经营生活场所需额外核验，不因出现房屋、店铺就满足。"},
    {"id": "criminal_purpose_before_entry", "text": "进入目标户之前已有侵害户内人身或财产的犯罪目的；包括适用条件下入户其他犯罪后转化，不能由发生抢劫反推。"},
    {"id": "robbery_inside_home", "text": "与目标罪行关联的抢劫及所需暴力/胁迫发生位置符合入户抢劫要求；户外拒捕不自动满足。"},
    {"id": "lawful_entry_then_new_intent", "text": "目标人物经允许因访友办事等非犯罪事由入户，随后才临时产生犯罪意图；未记载入户缘由为unknown。"},
    {"id": "qualifying_passenger_transport", "text": "工具为适用条款列明的客运交通工具或视同客运的大中型班车、校车；需工具类别证据，纯粹写车上不足。"},
    {"id": "small_taxi", "text": "目标工具为小型出租车；出租车大小不明为unknown，不自动否定例外。"},
    {"id": "transport_operating", "text": "目标工具当时处于客运运营状态；停车不当然排除运营，未说明为unknown。"},
    {"id": "robbery_on_or_intercepting_transport", "text": "目标抢劫发生于该客运工具内，或通过拦截其运营行程实施；需对应同一事件。"},
    {"id": "transport_victim_in_scope", "text": "目标被害人是该工具旅客或司售、乘务人员；不从职业或地点单独推断。"}
  ],
  "rules": [
    {"id": "surrender_escape_bar", "charges": ["诈骗罪", "抢劫罪"], "when": {"all": ["scope_surrender", "escaped_after_surrender"]}, "requires": [], "blocked_by": [], "effect": {"kind": "qualification_bar", "text": "此投案后逃跑路径阻却本草案的一般自首认定。"}, "source": "https://gongbao.court.gov.cn/Details/44c5c8dcc7367858830d4c7b8b215e.html#第一条", "version": "法释〔1998〕8号 第一条", "review_status": "draft", "reviewer": null},
    {"id": "surrender_retraction_bar", "charges": ["诈骗罪", "抢劫罪"], "when": {"all": ["scope_surrender", "retracted_after_disclosure", {"not": "truth_restored_before_judgment"}]}, "requires": [], "blocked_by": [], "effect": {"kind": "qualification_bar", "text": "翻供且判前未恢复如实供述，阻却该路径；恢复时间未知时阻却状态亦未知。"}, "source": "https://gongbao.court.gov.cn/Details/44c5c8dcc7367858830d4c7b8b215e.html#第一条", "version": "法释〔1998〕8号 第一条（二）", "review_status": "draft", "reviewer": null},
    {"id": "ordinary_surrender", "charges": ["诈骗罪", "抢劫罪"], "when": {"all": ["scope_surrender", "legal_voluntary_surrender", "main_facts_disclosed", "joint_disclosure_satisfied", "identity_disclosure_satisfied"]}, "requires": [], "blocked_by": ["surrender_escape_bar", "surrender_retraction_bar"], "effect": {"kind": "qualification", "text": "本草案覆盖的一般自首路径满足；不覆盖刑法67条第二款的其他路径，也不代表必然从宽。"}, "source": "https://gongbao.court.gov.cn/Details/44c5c8dcc7367858830d4c7b8b215e.html ; https://www.court.gov.cn/fabu/xiangqing/2484.html", "version": "法释〔1998〕8号 第一条；法发〔2010〕60号 第一、二部分", "review_status": "draft", "reviewer": null},
    {"id": "surrender_leniency", "charges": ["诈骗罪", "抢劫罪"], "when": "scope_surrender", "requires": ["ordinary_surrender"], "blocked_by": [], "effect": {"kind": "discretionary_leniency", "text": "可考虑从轻或减轻，具体选择仍需综合判断；不固定减刑比例。"}, "source": "https://gongbao.court.gov.cn/Details/44c5c8dcc7367858830d4c7b8b215e.html#第三条", "version": "法释〔1998〕8号 第三条", "review_status": "draft", "reviewer": null},
    {"id": "surrender_minor_exemption", "charges": ["诈骗罪", "抢劫罪"], "when": {"all": ["scope_surrender", "crime_minor_verified"]}, "requires": ["ordinary_surrender"], "blocked_by": [], "effect": {"kind": "discretionary_exemption", "text": "该自首路径且犯罪较轻时可考虑免除处罚；不得把输出刑期强制写成零。"}, "source": "https://gongbao.court.gov.cn/Details/44c5c8dcc7367858830d4c7b8b215e.html#第三条", "version": "法释〔1998〕8号 第三条", "review_status": "draft", "reviewer": null},
    {"id": "fraud_admission_repentance", "charges": ["诈骗罪"], "when": {"all": ["scope_fraud_article3", "admitted_guilt", "repented"]}, "requires": [], "blocked_by": [], "effect": {"kind": "partial_prerequisite", "text": "第三条共同前提满足，不单独推出免罚。"}, "source": "https://www.court.gov.cn/zixun/xiangqing/2472.html#第三条", "version": "法释〔2011〕7号 第三条", "review_status": "draft", "reviewer": null},
    {"id": "fraud_article3_two_branches", "charges": ["诈骗罪"], "when": {"any": ["full_restitution_before_judgment", "target_victim_forgiveness"]}, "requires": ["fraud_admission_repentance"], "blocked_by": [], "effect": {"kind": "discretionary_exemption", "text": "仅覆盖第三条退赔/谅解两条备选路径，满足时可考虑免予刑事处罚；未覆盖其他路径，refuted不等于全部免罚路径均不成立。"}, "source": "https://www.court.gov.cn/zixun/xiangqing/2472.html#第三条", "version": "法释〔2011〕7号 第三条（二）、（四）", "review_status": "draft", "reviewer": null},
    {"id": "home_entry_new_intent_bar", "charges": ["抢劫罪"], "when": {"all": ["scope_robbery_2016", "lawful_entry_then_new_intent"]}, "requires": [], "blocked_by": [], "effect": {"kind": "qualification_bar", "text": "此允许入户后才临时起意路径排除入户抢劫情节，不否定给定抢劫罪。"}, "source": "https://www.court.gov.cn/fabu/xiangqing/37412.html#第二部分", "version": "法发〔2016〕2号 二.1", "review_status": "draft", "reviewer": null},
    {"id": "home_robbery_qualifier", "charges": ["抢劫罪"], "when": {"all": ["scope_robbery_2016", "home_premises_verified", "criminal_purpose_before_entry", "robbery_inside_home"]}, "requires": [], "blocked_by": ["home_entry_new_intent_bar"], "effect": {"kind": "aggravating_qualification", "text": "本草案入户抢劫情节路径满足；不直接给出最终刑期，仍需核对刑法及其他量刑因素。"}, "source": "https://www.court.gov.cn/fabu/xiangqing/37412.html#第二部分", "version": "法发〔2016〕2号 二.1", "review_status": "draft", "reviewer": null},
    {"id": "small_taxi_bar", "charges": ["抢劫罪"], "when": {"all": ["scope_robbery_2016", "small_taxi"]}, "requires": [], "blocked_by": [], "effect": {"kind": "qualification_bar", "text": "小型出租车不计入本条公共交通工具，不否定抢劫罪。"}, "source": "https://www.court.gov.cn/fabu/xiangqing/37412.html#第二部分", "version": "法发〔2016〕2号 二.2", "review_status": "draft", "reviewer": null},
    {"id": "public_transport_robbery_qualifier", "charges": ["抢劫罪"], "when": {"all": ["scope_robbery_2016", "qualifying_passenger_transport", "transport_operating", "robbery_on_or_intercepting_transport", "transport_victim_in_scope"]}, "requires": [], "blocked_by": ["small_taxi_bar"], "effect": {"kind": "aggravating_qualification", "text": "本草案公共交通工具抢劫情节路径满足；不自动计算法定刑或宣告刑。"}, "source": "https://www.court.gov.cn/fabu/xiangqing/37412.html#第二部分", "version": "法发〔2016〕2号 二.2", "review_status": "draft", "reviewer": null}
  ]
}
